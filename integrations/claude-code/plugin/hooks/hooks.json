{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code" }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          { "type": "command", "command": "pong hook claude-code -listen", "asyncRewake": true, "timeout": 604800 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code", "timeout": 604800 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "pong hook claude-code -after-stop", "asyncRewake": true, "timeout": 604800 }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code", "timeout": 604800 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code", "timeout": 604800 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code", "asyncRewake": true, "timeout": 604800 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "pong hook claude-code" }
        ]
      }
    ]
  }
}
