data: {"seq":7,"kind":"ping.created","at":"2026-11-19T04:30:55.095753Z","data":{"id":"4a855b2716315ad6","session":"s-migrate","harness":"claude-code","project":"761aeaab99804467","folder":"/Users/dev/shop","question":"Two tables hold customer emails, and the migration rewrites 41,000 rows. Which should it touch?","answers":[{"label":"Users and orders","leads_to":"One migration that rewrites both tables in a single transaction.","hard_to_undo":true},{"label":"Users only","leads_to":"A smaller change; orders keep the email captured at checkout."},{"label":"Ask the data team"}],"context":"The users table and the orders table both store an email column. Orders copied it at checkout, so 3% of them disagree with users today.","why":"The migration script is written; it needs to know its scope before the dry run.","state":"waiting","created_at":"2026-11-19T04:30:55.095753Z","updated_at":"2026-11-19T04:30:55.095753Z"}}

